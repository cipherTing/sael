# Copy to .env and replace the sample values before starting Compose.
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password
DATABASE_URL=postgres://sael:replace-with-a-url-safe-random-password@db:5432/sael?sslmode=disable
ADMIN_PASSWORD=replace-with-a-strong-admin-password
GATEWAY_PORT=8080
UPSTREAM_URL=https://your-ai-upstream.example
UPSTREAM_API_KEY=
CLASSIFIER_TIMEOUT=5s
CLASSIFIER_CONCURRENCY=32
