# Copy to .env, set the three passwords, then run: docker compose up --build -d
# Never commit .env. Single-quote values containing $, # or spaces.
COMPOSE_PROJECT_NAME=sael
ADMIN_PASSWORD='replace-with-a-strong-admin-password'
POSTGRES_PASSWORD='replace-with-a-strong-database-password'
REDIS_PASSWORD='replace-with-a-strong-redis-password'

# Host bindings. Use 0.0.0.0 to expose a listener beyond this machine.
ADMIN_BIND_IP=127.0.0.1
ADMIN_PORT=8080
INGRESS_BIND_IP=127.0.0.1
INGRESS_PORT=8081
# Empty uses http://localhost:${INGRESS_PORT}; set the public URL behind a proxy.
INGRESS_PUBLIC_URL=

# Initial forwarding destination. Saved console settings survive restarts.
# HTTP(S) origin only; omit /v1 and credentials.
UPSTREAM_URL=
TRUSTED_PROXY_CIDRS=

# Jev input preflight: 90% of the documented 32k state+longest-question budget.
# Local cl100k_base estimate, not the vendor's tokenizer. Can be edited in Settings.
JEV_MAX_INPUT_TOKENS=28800
CLASSIFIER_TIMEOUT=5s

# Bundled PostgreSQL. The gateway encodes POSTGRES_PASSWORD into its connection URL.
POSTGRES_USER=sael
POSTGRES_DB=sael
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=disable
# Optional complete connection URL for an external database; overrides the fields above.
DATABASE_URL=

# Redis holds session freezes and buffers aggregates/events before PostgreSQL.
REDIS_HOST=redis
REDIS_PORT=6379
# Optional external Redis URL; overrides REDIS_HOST/PORT/PASSWORD.
REDIS_URL=

# HTTP ingress protection (same defaults as sub2api). SSE response duration is not limited.
MAX_REQUEST_BODY_SIZE=268435456
MAX_HEADER_BYTES=65536
READ_HEADER_TIMEOUT=10s
IDLE_TIMEOUT=120s
# Background reviews only; a full pool skips the review without delaying the relay.
ASYNC_REVIEW_CONCURRENCY=256

# Allow HTTP shutdown and background review draining before Docker sends SIGKILL.
STOP_GRACE_PERIOD=30s
