# Copy to .env, fill the five secrets below, then run: docker compose up -d --wait
# Quote values containing $, #, or spaces with single quotes.
ADMIN_PASSWORD=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
REVIEW_CACHE_REDIS_PASSWORD=
# Generate once with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# Optional: trusted reverse proxy IP range (CIDR), e.g. 192.0.2.10/32.
TRUSTED_PROXY_CIDRS=

# Change only when needed:
# ADMIN_PORT=8080
# INGRESS_PORT=8081
# INGRESS_PUBLIC_URL=https://gateway.example.com
